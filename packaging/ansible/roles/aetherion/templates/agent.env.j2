# The monitoring agent of this machine, run by aetherion-agent.service (C185). Written by
# Ansible (packaging/ansible): change the inventory, not this file.

AETHERION_NAME={{ aetherion_agent_name }}@{{ aetherion_agent_host }}
AETHERION_COOKIE={{ aetherion_cookie }}

# The ports the main server connects to: epmd on 4369, and the agent on this one.
ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min {{ aetherion_agent_dist_port }} inet_dist_listen_max {{ aetherion_agent_dist_port }}"
