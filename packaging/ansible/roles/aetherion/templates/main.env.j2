# The cookie and the workers of this main server. Written by Ansible (packaging/ansible):
# change the inventory, not this file. For a run:
#
#   set -a; . /etc/aetherion/main.env; set +a
#   aetherion run shop.perf --workers "$AETHERION_WORKERS"

AETHERION_COOKIE={{ aetherion_cookie }}
AETHERION_WORKERS={{ aetherion_workers | join(',') }}
