# The worker of this machine, run by aetherion-worker.service. Written by Ansible
# (packaging/ansible): change the inventory, not this file.

AETHERION_NAME={{ aetherion_worker_name }}@{{ aetherion_worker_host }}
AETHERION_COOKIE={{ aetherion_cookie }}

# The ports the main server connects to: epmd on 4369, and the worker on this one.
ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min {{ aetherion_dist_port }} inet_dist_listen_max {{ aetherion_dist_port }}"
