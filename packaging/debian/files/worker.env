# The worker of this machine, run by aetherion-worker.service:
#   sudo systemctl enable --now aetherion-worker
# After a change: sudo systemctl restart aetherion-worker

# Its node name, name@host: the name in the main server's Config and the address
# the main server reaches this machine at (C181). For
#   workers { euWorker1 { host = "10.0.0.11"; } }
# it is euWorker1@10.0.0.11.
AETHERION_NAME=

# A long random secret, the same on the main server and every worker, such as
# the output of: openssl rand -hex 32
AETHERION_COOKIE=

# The ports the main server connects to: epmd on 4369, and the worker on this one.
ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min 4370 inet_dist_listen_max 4370"
