# The monitoring agent of this machine, run by aetherion-agent.service (C185):
#   sudo systemctl enable --now aetherion-agent
# After a change: sudo systemctl restart aetherion-agent

# Its node name, name@host: the target in the main server's Config and the
# address the main server reaches this machine at. For
#   sut { sutServer1 { host = "192.168.178.91"; metrics = [cpu, mem, disk, net]; } }
#   monitoring { format = aetherion; }
# it is sutServer1@192.168.178.91.
AETHERION_NAME=

# A long random secret, the same on the main server, every worker and every
# agent, such as the output of: openssl rand -hex 32
AETHERION_COOKIE=

# The ports the main server connects to: epmd on 4369, and the agent on this one.
# Not 4370, so a worker can run on the same machine.
ELIXIR_ERL_OPTIONS="-kernel inet_dist_listen_min 4371 inet_dist_listen_max 4371"
