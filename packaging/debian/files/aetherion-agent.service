[Unit]
Description=Aetherion agent: measures this machine for a main server
Documentation=file:///usr/share/doc/aetherion/README.Debian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aetherion
Group=aetherion
# AETHERION_NAME, AETHERION_COOKIE and the distribution port.
EnvironmentFile=/etc/aetherion/agent.env
Environment=HOME=/var/lib/aetherion
StateDirectory=aetherion
WorkingDirectory=/var/lib/aetherion
ExecStart=/usr/bin/aetherion agent --name ${AETHERION_NAME}
Restart=on-failure
RestartSec=5
# 2: the agent cannot start, such as without a name or a cookie; restarting would not help.
RestartPreventExitStatus=2
# It only reads /proc: cpu, mem, disk and net of the host, so no private network or /proc.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
