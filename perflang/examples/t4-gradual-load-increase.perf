// Gradual load increase: start with 10 virtual users at once, ramp linearly
// to 100 users over 2 minutes, then hold 100 users for 2 minutes. Each user
// sends GET requests with 1 second think time between them.
//
// Per request, the engine records status code, latency and outcome
// (ok, failed, timeout, connectionError, assertFailed) on its own (C104,
// C105, C125), so the test needs no recording statements; output says
// where they are written.

TestSuite GradualLoadIncrease {
  Config {
    sut {
      productApi { baseUrl = "http://192.168.178.71:8080"; }
    }

    output {
      // One JSON line per request: latency, and the outcome that the error
      // rate over time is computed from (C120, C122).
      requests {
        file   = "results/gradual_load_increase_requests.jsonl";
        fields = [time, latency, outcome];
      }
      summary = "results/gradual_load_increase_summary.json";   // latency, errors.rate() and failed asserts (C121)
    }
  }

  Test GetProducts {
    Load {
      thinkTime 1s;                 // each user waits after every response (C16)
      requestTimeout 5s;            // a timeout counts as a failure (C105)

      stages [
        10vu  now,                  // all 10 users start at once (C127)
        100vu in  2m,               // linear ramp from 10 to 100 users (C24, C128)
        100vu for 2m                // hold 100 users
      ]
    }

    Actions {
      let response = sut.productApi.http.get("/api/products");

      // Only 200 is a success. Timeouts and connection errors have
      // status 0 (C110), so they fail this assert too. A failed assert
      // ends this iteration and the user goes on with its next one (C116).
      assert response.status == 200;
    }

    // Pass criterion: no failed request. A failed assert in Actions does not
    // fail the Test, Verify decides (C117). errors.count() includes failed
    // asserts: a request that was ok but fails the assert is recorded as
    // assertFailed, a timeout or connection error keeps its outcome (C107,
    // C125).
    Verify {
      assert errors.count() == 0;
    }
  }
}
