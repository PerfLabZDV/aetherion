// Create carts: 10 sequential POST requests with a JSON body from one
// virtual user.
//
// Per request, the engine records status code, latency and outcome
// (ok, failed, timeout, connectionError, assertFailed) on its own (C104,
// C105, C125), so the test needs no recording statements; output says
// where they are written.

TestSuite CreateCarts {
  Config {
    sut {
      cartApi { baseUrl = "http://192.168.178.71:8080"; }
    }

    output {
      // One JSON line per request, with the fields the prompt asks for (C120, C122).
      requests {
        file   = "results/create_carts_requests.jsonl";
        fields = [time, status, latency, outcome];
      }
      summary = "results/create_carts_summary.json";   // metrics and failed asserts (C121)
    }
  }

  Test CreateCart {
    Load {
      // No thinkTime: the default is 0ms, no wait between requests (C16).
      requestTimeout 5s;            // a timeout counts as a failure (C105)

      // One request per iteration, so 10 iterations = 10 sequential requests.
      stages [ 1vu for 10iter ]
    }

    Actions {
      // A JSON body is sent with Content-Type: application/json (C123).
      let response = sut.cartApi.http.post(
        "/api/carts",
        { "items": [{ "productId": 42, "quantity": 2 }] }
      );

      // Only 201 is a success. Timeouts and connection errors have
      // status 0 (C110), so they fail this assert too. A failed assert
      // ends this iteration and the other requests still run (C116).
      assert response.status == 201;
    }

    // Pass criterion: no failed request. A failed assert in Actions does not
    // fail the Test, Verify decides (C117). errors.count() includes failed
    // asserts: a request that was ok but fails the assert is recorded as
    // assertFailed, a timeout or connection error keeps its outcome (C107,
    // C125).
    Verify {
      assert errors.count() == 0;
    }
  }
}
